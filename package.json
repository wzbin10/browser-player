{
  "name": "browser-player",
  "version": "0.1.0",
  "description": "面向桌面 Chrome/Edge 的多路浏览器视频播放 SDK，统一封装 mp4 / HLS / FLV，单例调度 + 按需解码，解决多视频并发卡顿与 CPU、内存飙升问题",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "demo:build": "esbuild demo/main.ts --bundle --format=esm --target=es2020 --sourcemap --legal-comments=none --outfile=demo/.build/main.js",
    "demo:watch": "esbuild demo/main.ts --bundle --format=esm --target=es2020 --sourcemap --legal-comments=none --watch --outfile=demo/.build/main.js",
    "demo:serve": "python -m http.server 5173",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "video",
    "player",
    "hls",
    "flv",
    "mpegts",
    "mse",
    "live",
    "sdk"
  ],
  "license": "MIT",
  "author": "wzbin10 <wzbin1026@163.com>",
  "peerDependencies": {
    "hls.js": ">=1.4.0",
    "mpegts.js": ">=1.7.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    },
    "mpegts.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.7.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
